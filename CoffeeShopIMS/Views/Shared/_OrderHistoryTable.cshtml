@using CoffeeShopIMS.ViewModels

@model OrderHistoryViewModel

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Bill number</th>
                <th>Procurement maker</th>
                <th>Purchased at</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (PurchaseOrder order in Model.Orders)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.OrderNumber</td>
                    <td>@order.OrderPerson</td>
                    <td>@order.CreationDate</td>
                    <td>@order.Status</td>
                    <td>
                        <a asp-controller="OrderDetail" asp-action="Index" asp-route-id="@order.Id"
                            class="btn btn-secondary btn-sm">Show details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>